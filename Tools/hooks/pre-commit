#!/usr/bin/env bash
#
# pre-commit hook for FPBInject (local development)
#
# Runs the FAST subset of the CI checks against STAGED files only, so the
# heavy jobs (build_test, unit tests, coverage) stay in CI while obvious
# formatting/lint mistakes are caught before they are committed.
#
# Mirrors these CI steps (see .github/workflows/ci.yml):
#   - C/C++ clang-format --check        (Tools/code_format.sh)
#   - CMake cmake-format --check        (Tools/cmake_format.sh)
#   - Shell shfmt -d
#   - Kconfig lint                      (Tools/kconfig_lint.py)
#   - Python black --check + flake8     (Tools/WebServer/format.sh)
#   - JS/HTML/CSS prettier --check
#
# Any check whose tool is missing is skipped with a notice (never blocks).
# Bypass entirely with `git commit --no-verify`.
#
# Installed by Tools/hooks/install.sh (which points core.hooksPath here).

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

FAILED=0
CHECKS_RUN=0

note() { echo -e "${BLUE}[pre-commit]${NC} $*"; }
skip() { echo -e "${YELLOW}[pre-commit] skip:${NC} $*"; }
fail() {
    echo -e "${RED}[pre-commit] FAIL:${NC} $*"
    FAILED=1
}
ok() { echo -e "${GREEN}[pre-commit] ok:${NC} $*"; }

# Collect staged (Added/Copied/Modified) files, NUL-safe.
staged_files() {
    git diff --cached --name-only --diff-filter=ACM -z
}

# Filter staged file list by one or more shell globs (matched on basename/path).
# Usage: staged_match '*.c' '*.h'
staged_match() {
    local patterns=("$@")
    local f
    while IFS= read -r -d '' f; do
        [ -f "$f" ] || continue
        local p
        for p in "${patterns[@]}"; do
            # shellcheck disable=SC2053
            if [[ "$f" == $p ]]; then
                printf '%s\n' "$f"
                break
            fi
        done
    done < <(staged_files)
}

# ------------------------------------------------------------------
# 1. C/C++ clang-format (Source/, App/)
# ------------------------------------------------------------------
check_clang_format() {
    local cf=""
    if command -v clang-format-14 &>/dev/null; then
        cf=clang-format-14
    elif command -v clang-format &>/dev/null; then
        cf=clang-format
    else
        skip "clang-format not installed (C/C++ format check)"
        return
    fi

    local files
    files=$(staged_match 'Source/*.c' 'Source/*.h' 'Source/*.cpp' 'Source/*.hpp' \
        'App/*.c' 'App/*.h' 'App/*.cpp' 'App/*.hpp')
    [ -z "$files" ] && return

    CHECKS_RUN=$((CHECKS_RUN + 1))
    local bad=""
    local f
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if ! "$cf" --dry-run --Werror "$f" &>/dev/null; then
            bad="$bad $f"
        fi
    done <<<"$files"

    if [ -n "$bad" ]; then
        fail "C/C++ needs formatting:$bad"
        echo "        fix: Tools/code_format.sh"
    else
        ok "C/C++ clang-format"
    fi
}

# ------------------------------------------------------------------
# 2. Shell shfmt (Tools/**)
# ------------------------------------------------------------------
check_shfmt() {
    command -v shfmt &>/dev/null || {
        skip "shfmt not installed (shell format check)"
        return
    }

    local files
    files=$(staged_match '*.sh')
    [ -z "$files" ] && return

    CHECKS_RUN=$((CHECKS_RUN + 1))
    local bad=""
    local f
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if ! shfmt -d -i 4 -ci -bn "$f" >/dev/null 2>&1; then
            bad="$bad $f"
        fi
    done <<<"$files"

    if [ -n "$bad" ]; then
        fail "shell needs formatting:$bad"
        echo "        fix: shfmt -w -i 4 -ci -bn <file>"
    else
        ok "shell shfmt"
    fi
}

# ------------------------------------------------------------------
# 3. CMake cmake-format
# ------------------------------------------------------------------
check_cmake_format() {
    local cmf=""
    export PATH="$PATH:$HOME/.local/bin"
    if command -v cmake-format &>/dev/null; then
        cmf=cmake-format
    elif command -v gersemi &>/dev/null; then
        cmf=gersemi
    else
        skip "cmake-format not installed (CMake format check)"
        return
    fi

    local files
    files=$(staged_match 'CMakeLists.txt' '*/CMakeLists.txt' '*.cmake')
    [ -z "$files" ] && return

    CHECKS_RUN=$((CHECKS_RUN + 1))
    local bad=""
    local f
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if [ "$cmf" = "cmake-format" ]; then
            if [ "$("$cmf" "$f" 2>/dev/null)" != "$(cat "$f")" ]; then
                bad="$bad $f"
            fi
        else
            if ! "$cmf" --check "$f" &>/dev/null; then
                bad="$bad $f"
            fi
        fi
    done <<<"$files"

    if [ -n "$bad" ]; then
        fail "CMake needs formatting:$bad"
        echo "        fix: Tools/cmake_format.sh"
    else
        ok "CMake format"
    fi
}

# ------------------------------------------------------------------
# 4. Kconfig lint
# ------------------------------------------------------------------
check_kconfig() {
    local files
    files=$(staged_match 'Kconfig' '*/Kconfig' 'Kconfig.*' '*/Kconfig.*')
    [ -z "$files" ] && return

    if ! python3 -c "import kconfiglib" &>/dev/null; then
        skip "kconfiglib not installed (Kconfig lint)"
        return
    fi

    CHECKS_RUN=$((CHECKS_RUN + 1))
    # shellcheck disable=SC2086
    if python3 Tools/kconfig_lint.py $files >/dev/null 2>&1; then
        ok "Kconfig lint"
    else
        fail "Kconfig lint errors"
        echo "        run: python3 Tools/kconfig_lint.py $files"
    fi
}

# ------------------------------------------------------------------
# 5. Python black --check + flake8 (whole repo staged *.py)
# ------------------------------------------------------------------
check_python() {
    local files
    files=$(staged_match '*.py')
    [ -z "$files" ] && return

    # black --check
    if python3 -m black --version &>/dev/null; then
        CHECKS_RUN=$((CHECKS_RUN + 1))
        # shellcheck disable=SC2086
        if python3 -m black --check --quiet --line-length 88 $files 2>/dev/null; then
            ok "Python black"
        else
            fail "Python needs formatting (black)"
            echo "        fix: python3 -m black --line-length 88 <files>  (or Tools/WebServer/format.sh)"
        fi
    else
        skip "black not installed (Python format check)"
    fi

    # flake8 (split test vs src ignore rules, matching format.sh)
    if command -v flake8 &>/dev/null; then
        CHECKS_RUN=$((CHECKS_RUN + 1))
        local test_files="" src_files="" f
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            if [[ "$f" == */tests/* ]]; then
                test_files="$test_files $f"
            else
                src_files="$src_files $f"
            fi
        done <<<"$files"

        local lint_ok=1
        if [ -n "$src_files" ]; then
            # shellcheck disable=SC2086
            flake8 --ignore=E501,W503,E203 --max-line-length=120 $src_files || lint_ok=0
        fi
        if [ -n "$test_files" ]; then
            # shellcheck disable=SC2086
            flake8 --ignore=E501,W503,E203,E402 --max-line-length=120 $test_files || lint_ok=0
        fi
        if [ "$lint_ok" = 1 ]; then
            ok "Python flake8"
        else
            fail "Python flake8 warnings"
        fi
    else
        skip "flake8 not installed (Python lint)"
    fi
}

# ------------------------------------------------------------------
# 6. Prettier for JS/HTML/CSS (excludes vendored libs)
# ------------------------------------------------------------------
check_prettier() {
    local prettier=""
    if command -v prettier &>/dev/null; then
        prettier="prettier"
    elif command -v npx &>/dev/null; then
        prettier="npx --yes prettier"
    else
        skip "prettier not installed (JS/HTML/CSS format check)"
        return
    fi

    local files
    files=$(staged_match '*.js' '*.html' '*.css' \
        | grep -v 'static/js/lib/' \
        | grep -v 'node_modules/' || true)
    [ -z "$files" ] && return

    CHECKS_RUN=$((CHECKS_RUN + 1))
    # prettier --check reads its own config; batch all files.
    # shellcheck disable=SC2086
    if $prettier --check $files >/dev/null 2>&1; then
        ok "JS/HTML/CSS prettier"
    else
        fail "JS/HTML/CSS needs formatting (prettier)"
        echo "        fix: Tools/WebServer/format.sh"
    fi
}

# ------------------------------------------------------------------
# 7. Source file line-count limit (guards against oversized new files)
# ------------------------------------------------------------------
check_file_lines() {
    command -v python3 &>/dev/null || {
        skip "python3 not found (file line-count check)"
        return
    }

    local files
    files=$(staged_match '*.py' '*.c' '*.h' '*.cpp' '*.hpp' '*.js')
    [ -z "$files" ] && return

    CHECKS_RUN=$((CHECKS_RUN + 1))
    # shellcheck disable=SC2086
    local out
    out=$(python3 Tools/check_file_lines.py $files 2>&1)
    if [ $? -eq 0 ]; then
        ok "file line-count limit"
    else
        fail "file exceeds line-count limit"
        echo "$out" | sed 's/^/        /'
    fi
}

note "running fast checks on staged files (bypass with --no-verify)"

check_clang_format
check_shfmt
check_cmake_format
check_kconfig
check_python
check_prettier
check_file_lines

echo ""
if [ "$FAILED" -ne 0 ]; then
    echo -e "${RED}✗ pre-commit checks failed.${NC} Fix the issues above or use 'git commit --no-verify' to skip."
    exit 1
fi

if [ "$CHECKS_RUN" -eq 0 ]; then
    note "no checkable files staged; nothing to do"
else
    echo -e "${GREEN}✓ pre-commit checks passed ($CHECKS_RUN check group(s)).${NC}"
fi
exit 0
