#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig FPBINJECT
	tristate "FPBInject - Cortex-M FPB Runtime Injection Tool"
	default n
	---help---
		Enable FPBInject function loader. This is a runtime code injection
		tool using ARM Cortex-M Flash Patch and Breakpoint (FPB) unit.
		It allows dynamic function patching and redirection at runtime.

if FPBINJECT

config FPBINJECT_PRIORITY
	int "FPBInject task priority"
	default 100

config FPBINJECT_STACKSIZE
	int "FPBInject stack size"
	default 8192

config FPBINJECT_BUF_SIZE
	int "Static code buffer size"
	default -1
	---help---
		Size of the static buffer used for code injection.
		This buffer is used to store injected code.
		Set to -1 to use the dynamic buffer allocation.

config FPBINJECT_LINE_SIZE
	int "Command line buffer size"
	default 1024
	---help---
		Size of the command line input buffer for interactive mode.

config FPBINJECT_NO_FPB
	bool "Disable FPB hardware"
	default n
	depends on ARCH_ARM && (ARCH_CORTEXM3 || ARCH_CORTEXM4 || ARCH_CORTEXM7 || ARCH_CORTEXM33 || ARCH_CORTEXM55)
	---help---
		Disable all FPB hardware operations. Patch/tpatch/dpatch/unpatch/enable
		commands will return FL_ERR_DISABLED. Useful for platforms without FPB
		support or for memory-only injection scenarios.

config FPBINJECT_NO_TRAMPOLINE
	bool "Disable trampoline mode"
	default n
	depends on !FPBINJECT_NO_FPB
	---help---
		Disable trampoline-based injection. tpatch command will return error.
		Use when FPB can REMAP to RAM directly without trampoline intermediaries.

config FPBINJECT_NO_DEBUGMON
	bool "Disable DebugMonitor mode"
	default n
	depends on !FPBINJECT_NO_FPB
	---help---
		Disable DebugMonitor-based injection. dpatch command will return error.
		Use on platforms without DebugMonitor exception support.

endif # FPBINJECT
